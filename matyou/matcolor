#!/bin/sh
# matcolor — retheme Ghostty (and every open terminal) from an image.
#
#   matcolor                      use the current macOS wallpaper
#   matcolor ~/Pictures/wall.jpg  use a specific image
#   matcolor --color '#7B4FA8'    use an explicit accent colour
#   matcolor --mode light         force light mode (default follows macOS)
#   matcolor --scheme scheme-expressive
#
# Ported from end-4/dots-hyprland (illogical-impulse).
#
# Defaults applied to every run. argparse takes the last occurrence of a flag, so
# passing the same flag on the command line overrides whatever is set here.
# Edit this line to change your baseline look.
: "${MATYOU_DEFAULTS:=--scheme scheme-neutral --color #8A8F98 --background #1A1A1A}"

# shellcheck disable=SC2086  # word splitting is intentional for the defaults
exec "$HOME/.local/share/matyou/venv/bin/python" \
     "$HOME/.local/share/matyou/generate.py" $MATYOU_DEFAULTS "$@"
